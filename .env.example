# ── NextAuth v5 ──────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost

# ── Veritabanı ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@postgres:5432/mikro_destek

# ── MinIO ────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_BUCKET_APPLICATIONS=mdf-applications
MINIO_BUCKET_PROJECTS=mdf-projects

# ── Circle Platform ───────────────────────────────────────
# Komünite üyelik doğrulaması için
CIRCLE_API_TOKEN=
CIRCLE_COMMUNITY_ID=

# ── E-posta (Resend) ─────────────────────────────────────
# Jüri magic link davet e-postaları için
RESEND_API_KEY=
EMAIL_FROM=noreply@mikrodestekfonu.com

# ── Docker Compose (container env) ───────────────────────
POSTGRES_DB=mikro_destek
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
