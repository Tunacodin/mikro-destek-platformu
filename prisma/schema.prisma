generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enum Tanımları ───────────────────────────────────────

enum Role {
  ADMIN
  APPLICANT
  JURY
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  EVALUATED
  SUPPORTED
  REJECTED
}

enum PeriodStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// ── NextAuth v5 Adapter Modelleri ────────────────────────
// JWT strategy ile Account kullanılmaz, ancak adapter contract için gerekli.
// VerificationToken gelecekteki email provider kullanımı için tutulur.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Kullanıcı ────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  role                Role      @default(APPLICANT)
  passwordHash        String?
  emailVerified       DateTime?
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Profil alanları (başvuru formundan kaydedilir)
  phone               String?
  educationStatus     String?
  department          String?
  address             String?
  communityProfileUrl String?
  linkedinUrl         String?
  twitterUrl          String?

  // Jüri künyesi alanları
  juryTitle           String?   // Ünvan / Rol
  juryOrganization    String?   // Kurum / Organizasyon
  juryExpertise       String[]  // Uzmanlık alanları
  juryBio             String?   // Profesyonel profil açıklaması
  juryActive          Boolean   @default(true) // Aktif / Pasif

  accounts        Account[]
  applications    Application[]
  juryAssignments JuryAssignment[]
  evaluations     Evaluation[]
  fileNotes       FileNote[]
  decisions       SupportDecision[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

// ── Başvuru Dönemi ───────────────────────────────────────

model ApplicationPeriod {
  id        String       @id @default(cuid())
  title     String
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  applications Application[]
}

// ── Program ──────────────────────────────────────────────

model Program {
  id        String        @id @default(cuid())
  title     String
  startDate DateTime
  endDate   DateTime
  status    ProgramStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  applications Application[]
}

// ── Başvuru ──────────────────────────────────────────────

model Application {
  id               String            @id @default(cuid())
  title            String
  status           ApplicationStatus @default(DRAFT)
  submittedAt      DateTime?
  presentationDate DateTime?         // Admin tarafından Aşama 3'te set edilir (jüri sunum tarihi)
  reviewNotes      String?           @db.Text // Revize/red notları
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  evaluationsLocked Boolean @default(false) // Admin tarafından jüri düzenleme yetkisi kapatılabilir

  // Proje kimliği
  teamName       String?           // Ekip / Proje adı
  teamInfo       String?  @db.Text
  summary        String?  @db.Text  // 30 saniyelik pitch (max 1500 karakter)
  targetAudience String?  @db.Text
  categories     String[]            // max 2: Teknoloji/Girişimcilik | Sanat/Kültürel/İçerik | Araştırma/Akademik
  technologyStage String?
  artStage        String?
  researchStage   String?

  // Proje detayı
  problemStatement       String?  @db.Text
  solution               String?  @db.Text
  innovation             String?  @db.Text

  // Plan & hedefler
  outputs         String?  @db.Text
  timeline        String?  @db.Text
  successCriteria String?  @db.Text

  // Ekosistem & topluluk
  ecosystemCollaboration String?  @db.Text
  communityContribution  String?  @db.Text
  divisionContribution   String?  @db.Text

  // İstenen destek türleri
  supportTypes String[]
  supportNotes Json?      // { "Destek Türü": "Neden istiyorum..." } şeklinde

  userId    String
  user      User               @relation(fields: [userId],    references: [id])
  periodId  String?
  period    ApplicationPeriod? @relation(fields: [periodId],  references: [id])
  programId String?
  program   Program?           @relation(fields: [programId], references: [id])

  files           File[]
  juryAssignments JuryAssignment[]
  evaluations     Evaluation[]
  decision        SupportDecision?
  project         Project?
}

// ── Dosya ────────────────────────────────────────────────

model File {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int
  mimeType  String
  bucket    String
  key       String
  type      String   @default("FILE") // "FILE" veya "LINK"
  createdAt DateTime @default(now())

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])

  notes FileNote[]
}

// ── Jüri Atama ───────────────────────────────────────────

model JuryAssignment {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  juryId        String
  jury          User        @relation(fields: [juryId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  @@unique([juryId, applicationId])
}

// ── Değerlendirme ────────────────────────────────────────

model Evaluation {
  id        String   @id @default(cuid())
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  juryId        String
  jury          User        @relation(fields: [juryId], references: [id])
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  scores EvaluationScore[]

  @@unique([juryId, applicationId])
}

model EvaluationScore {
  id            String @id @default(cuid())
  criteria      String
  score         Int // 1-5 arası; Zod ile API katmanında doğrulanır
  justification String @db.Text // Zorunlu gerekçe metni

  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

// ── Dosya Notu ───────────────────────────────────────────

model FileNote {
  id        String   @id @default(cuid())
  note      String   @db.Text
  createdAt DateTime @default(now())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// ── Destek Kararı ─────────────────────────────────────────

model SupportDecision {
  id        String   @id @default(cuid())
  // UNSUPPORTED | LIMITED | EXTENDED | PRIORITY
  scope     String
  notes     String?  @db.Text
  decidedAt DateTime @default(now())

  // Bildiri formu alanları (admin tarafından doldurulur)
  strategicReason      String?  @db.Text // Stratejik Uyum Gerekçesi
  expectedOutputs      String?  @db.Text // Beklenen Somut Çıktılar
  supportDuration      String?           // Destek Süresi (örn. "6 ay")
  additionalConditions String?  @db.Text // Ek Açıklamalar ve Şartlar
  riskFramework        String?  @db.Text // Risk ve Sorumluluk Çerçevesi

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  decidedById   String
  decidedBy     User        @relation(fields: [decidedById], references: [id])

  project Project?
}

// ── Proje ─────────────────────────────────────────────────

model Project {
  id             String    @id @default(cuid())
  status         String    @default("ACTIVE")
  supportEndDate DateTime? // Admin tarafından Aşama 5b'de set edilir (destek süresi bitişi)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applicationId String          @unique
  application   Application     @relation(fields: [applicationId], references: [id])
  decisionId    String          @unique
  decision      SupportDecision @relation(fields: [decisionId], references: [id])

  files   File[]
  reports ProjectReport[]
}

model ProjectReport {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  juryId    String?  // null = başvuru sahibi notu; dolu = jüri notu (sadece admin görür)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

// ── Jüri Davet Token (Magic Link) ────────────────────────
// ADMIN tarafından oluşturulur; jüri üyesi sisteme kayıtsız girer.
// NextAuth Email provider DEĞİL, custom akış kullanılır.

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  email     String
  name      String?
  metadata  Json?     // Jüri künyesi vb. ek bilgiler
  expiresAt DateTime
  usedAt    DateTime? // İlk kullanımda doldurulur — tek kullanımlık
  createdAt DateTime  @default(now())
}

// ── Bildirim ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Denetim Günlüğü ──────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
